{
    "name": "useyona/einvoice-php",
    "description": "Official PHP SDK for the Yona e-invoicing API — what an API key may call: invoicing, submissions to the tax authority, buyers, items, received invoices, billing reads and webhooks",
    "type": "library",
    "license": "MIT",
    "keywords": ["einvoice", "e-invoice", "electronic-invoice", "tax-compliance", "tax", "invoice", "billing", "sdk", "api-client", "yona", "nrs", "nigeria", "psr-18"],
    "homepage": "https://useyona.com/docs/sdks/php/installation",
    "support": {
        "issues": "https://github.com/Elyonar/einvoice-php/issues",
        "source": "https://github.com/Elyonar/einvoice-php"
    },
    "authors": [
        {"name": "Yona", "email": "dev@useyona.com"}
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0",
        "guzzlehttp/guzzle": "^7.8",
        "nyholm/psr7": "^1.8",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 client the SDK discovers automatically (any PSR-18 client and PSR-17 factories work)",
        "nyholm/psr7": "PSR-17 request and stream factories the SDK discovers automatically"
    },
    "autoload": {
        "psr-4": {
            "Useyona\\EInvoice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Useyona\\EInvoice\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": ["phpstan analyse", "php-cs-fixer fix --dry-run --diff"],
        "fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
